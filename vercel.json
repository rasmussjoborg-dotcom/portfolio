{
    "rewrites": [
        {
            "source": "/cv",
            "destination": "/cv.html"
        },
        {
            "source": "/jobradar",
            "destination": "/jobradar.html"
        },
        {
            "source": "/hub",
            "destination": "/hub.html"
        },
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "hub.rsjo.io" }],
            "destination": "/hub.html"
        }
    ],
    "crons": [
        {
            "path": "/api/jobs/fetch",
            "schedule": "0 8 * * *"
        }
    ]
}